# Copy to .env and fill in. Production values live in Netlify env vars.

# --- GitHub sign-in (required for /admin) -----------------------------------
# Register an OAuth app at https://github.com/settings/developers.
# A GitHub OAuth app allows one callback URL, so register two apps:
#   production : https://pwsh.ca/api/auth/callback
#   local dev  : http://localhost:8888/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs session cookies. Any long random string, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
SESSION_SECRET=

# Your GitHub username. This account is auto-approved as owner on first
# sign-in, and is the only one that can approve or remove other members.
OWNER_GITHUB_LOGIN=

# --- Break-glass -------------------------------------------------------------
# Optional. A shared token with full owner rights, for scripts that predate
# per-user API keys and for recovering access. Leave blank to disable.
ADMIN_TOKEN=
